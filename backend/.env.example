# Local development template. Copy to .env and replace every placeholder.
# Never commit .env or use these values in production.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=falcon_energy_db
DB_USERNAME=postgres
DB_PASSWORD=replace-with-a-long-random-password
JWT_SECRET=replace-with-a-base64-encoded-key-at-least-256-bits
BOOTSTRAP_ADMIN_PASSWORD=replace-before-first-start
CORS_ALLOWED_ORIGINS=http://localhost:8080
FLUTTERWAVE_CLIENT_ID=
FLUTTERWAVE_CLIENT_SECRET=
FLUTTERWAVE_BASE_URL=https://developersandbox-api.flutterwave.com
FLUTTERWAVE_ENVIRONMENT=sandbox
FLUTTERWAVE_WEBHOOK_SECRET_HASH=
FLUTTERWAVE_REDIRECT_URL=http://localhost:8080/customer
# Optional: scenario:auth_redirect for mobile money redirect testing.
FLUTTERWAVE_SCENARIO_KEY=
PAWAPAY_API_TOKEN=
PAWAPAY_BASE_URL=https://api.sandbox.pawapay.io
PAWAPAY_ENVIRONMENT=sandbox
# Public OSRM is for light local testing only; self-host or use a managed compatible provider in production.
ROUTING_BASE_URL=https://router.project-osrm.org
# Comma-separated OSRM-compatible failover endpoints.
ROUTING_FALLBACK_BASE_URLS=https://routing.openstreetmap.de/routed-car
# When all external providers are unavailable, allow a clearly labelled distance estimate instead of blocking orders.
ROUTING_ALLOW_ESTIMATED_FALLBACK=true
ROUTING_TIMEOUT_SECONDS=12
