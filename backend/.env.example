# Local development template. Copy to .env and replace every placeholder.
# Never commit .env or use these values in production.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=falcon_energy_db
DB_USERNAME=postgres
DB_PASSWORD=replace-with-a-long-random-password
JWT_SECRET=replace-with-a-base64-encoded-key-at-least-256-bits
BOOTSTRAP_ADMIN_PASSWORD=replace-before-first-start
CORS_ALLOWED_ORIGINS=http://localhost:8080
